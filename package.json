{
  "name": "clinic-booking-api",
  "version": "1.0.0",
  "description": "Clinic booking API and web page for the Koya assessment",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && npm --prefix client install --include=dev && npm --prefix client run build",
    "start": "node dist/server.js",
    "db:init": "tsx src/init-db.ts",
    "check": "tsx scripts/check.ts",
    "test:auth": "node --import tsx --test scripts/auth.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
